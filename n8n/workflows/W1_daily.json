{
  "id": "tsW1DailyBrief01",
  "name": "W1 아침 브리핑 (07:00 실행 · 08:00 발송)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000001",
      "name": "07:00 트리거",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/api/w1/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000002",
      "name": "하루 실행 시작",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "toolscoutServiceKey",
          "name": "toolscout 서비스 키"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000003",
      "name": "08:00 트리거",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 240]
    },
    {
      "parameters": {
        "url": "http://app:8000/api/w1/outbox",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000004",
      "name": "발송함 가져오기",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 240],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "toolscoutServiceKey",
          "name": "toolscout 서비스 키"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "2b0d3f1e-7a1c-4f3e-9d10-0000000000c1",
              "leftValue": "={{ $json.dev_mode }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000005",
      "name": "개발 모드?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/api/w1/sent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $json.date, user_ids: $json.messages.map(m => m.user_id) }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000006",
      "name": "개발 모드: 보내지 않고 기록만",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 120],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "toolscoutServiceKey",
          "name": "toolscout 서비스 키"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "messages",
        "options": {}
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000007",
      "name": "사용자별로 나누기",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [720, 360]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000008",
      "name": "메일 보내기",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 360],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "smtp": {
          "id": "toolscoutGmailSmtp",
          "name": "toolscout Gmail SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/api/w1/sent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $('발송함 가져오기').first().json.date, user_ids: [$('사용자별로 나누기').item.json.user_id] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2b0d3f1e-7a1c-4f3e-9d10-000000000009",
      "name": "발송 기록",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "toolscoutServiceKey",
          "name": "toolscout 서비스 키"
        }
      }
    }
  ],
  "connections": {
