         {"type": "mcp", "install_cmd": "docker run c-mcp", "verification": {"install": {"status": "bad", "label": "설치 실패 30.0s"}, "run": {"status": "na", "label": "실행 미확인"}, "tools_list": {"status": "na", "label": "도구 목록 미확인"}, "auth_required": {"status": "na", "label": "인증 미확인"}}},
