     "badge": {"word": "검증 통과", "tone": "pass", "icon": "ok"}},
    {"id": "mcp-auth-na", "card": {"type": "mcp", "verification": {"install": {"status": "ok"}, "run": {"status": "ok"}, "tools_list": {"status": "ok"}, "auth_required": {"status": "na"}}},
