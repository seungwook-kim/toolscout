# 복사해서 .env로 쓴다. 비밀값은 .env에만 둔다 (작업 규칙 8).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
E2B_API_KEY=
GITHUB_TOKEN=
SKILLSMP_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
GMAIL_USER=
GMAIL_APP_PASSWORD=
MCP_SERVICE_KEY=
SESSION_SECRET=
DAILY_QUESTION_LIMIT=10
DAILY_PROBE_LIMIT=3
ADMIN_EMAILS=
# 1이면 무료 개발 모델표(가짜 프로필·공개 뉴스만), 0이면 운영 모델표
DEV_MODE=1
OPENROUTER_API_KEY=
# 개발 모드 두 번째 제공자 (Groq 무료, https://console.groq.com/keys). 로컬 Ollama는 키가 필요 없다
GROQ_API_KEY=
# 앱 안 예약(07:00 실행·08:00 발송). 0이면 끈다
SCHEDULER_ENABLED=1
