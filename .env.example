# 복사해서 .env로 쓴다. 비밀값은 .env에만 둔다 (작업 규칙 8).
# 운영 모드(DEV_MODE=0)의 첫 모델 Claude Haiku 5.5 호출용 Anthropic API 키. 서버(Railway·Vercel)에 꼭 넣는다. 개발 모드는 구독이라 안 쓴다
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
E2B_API_KEY=
GITHUB_TOKEN=
SKILLSMP_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
GMAIL_USER=
GMAIL_APP_PASSWORD=
MCP_SERVICE_KEY=
SESSION_SECRET=
DAILY_QUESTION_LIMIT=10
DAILY_PROBE_LIMIT=3
ADMIN_EMAILS=
# 1이면 무료 개발 모델표(가짜 프로필·공개 뉴스만), 0이면 운영 모델표
DEV_MODE=1
# 운영 모드 둘째 칸(gpt-4o-mini, Haiku 5.5 실패 시 대체)
OPENROUTER_API_KEY=
# 개발 모드 두 번째 제공자 (Groq 무료, https://console.groq.com/keys). 로컬 Ollama는 키가 필요 없다
GROQ_API_KEY=
# 앱 안 예약(07:00 실행·08:00 발송). 0이면 끈다
SCHEDULER_ENABLED=1
# 로그인·피드백 메일 링크의 앱 주소 (기본 http://127.0.0.1:8000)
APP_BASE_URL=
# 뉴스 중요도 점수(Jev, agent/importance.py). 비어 있으면 선별 모델 점수를 그대로 쓴다
JEV_API_KEY=

# ---- 선택 설정 (tests/env/check_env_example.py 가 위 키 목록만 검사하므로 아래는 주석으로 둔다) ----
# 구글 로그인·Gmail API 발송용 OAuth 클라이언트. 둘 다 없으면 구글 로그인 버튼이 숨겨진다
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# 메일 발송 방식: smtp(기본) | gmail_api (Railway 처럼 바깥 SMTP 를 막는 곳)
# MAIL_TRANSPORT=smtp
# 검수용: 이 폴더에 메일을 JSON 파일로만 쓰고 실제로 보내지 않는다
# MAIL_FAKE_DIR=
# MCP 서버 주소 (기본 http://127.0.0.1:8000/mcp). inproc 이면 같은 프로세스에 메모리로 붙는다 (크론은 자동으로 inproc)
# MCP_URL=
# 1이면 예약 작업이 앱 밖(Railway 크론)에서 돈다. 웹(Vercel)에서 쓴다
# JOBS_EXTERNAL=0
# 요청 횟수 제한(분당): 로그인 사용자 기본 120, 비로그인 기본 30. RATE_LIMIT_OFF=1 이면 끈다(검수용)
# RATE_LIMIT_USER=120
# RATE_LIMIT_ANON=30
# RATE_LIMIT_OFF=0
# 0이면 git 변경을 감지해 스스로 다시 켜는 기능을 끈다 (기본 켜짐)
# AUTO_RESTART=1
# AI 호출 기록을 쌓는 로컬 파일 (기본 toolscout_trace.jsonl)
# LOCAL_TRACE_LOG=
